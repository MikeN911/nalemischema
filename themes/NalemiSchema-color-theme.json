			"scope": [
				"constant.numeric.php",
				"constant.language.php",
				"support.constant.std.php"
			],
			"settings": {
				"foreground": "#0000FF",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Decimal / Float Numbers in PHP",
			"scope": [
				"constant.numeric.integer.decimal.php",
